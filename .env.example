# NordVPN WireGuard Configuration
# See README.md for instructions on how to extract this private key
WIREGUARD_PRIVATE_KEY=your_private_key_here

# Gluetun API Key
GLUETUN_API_KEY=secret-key

# Optional paid fallback used only for explicit Instagram post-level age gates.
# SocialCrawl returns short-lived signed Instagram CDN URLs; Pinchana downloads
# them immediately and stores only local media paths in its cache.
SOCIALCRAWL_API_KEY=
SOCIALCRAWL_TIMEOUT_SECONDS=20
