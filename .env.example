# NordVPN WireGuard Configuration
# See README.md for instructions on how to extract this private key
WIREGUARD_PRIVATE_KEY=your_private_key_here

# Gluetun API Key
GLUETUN_API_KEY=secret-key

# Optional paid fallback for explicit post-level Instagram age gates.
# If empty, explicit age-gated posts report the resolver as unavailable.
SOCIALCRAWL_API_KEY=
SOCIALCRAWL_TIMEOUT_SECONDS=15
